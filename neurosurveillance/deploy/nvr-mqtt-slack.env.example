# Environment for nvr-mqtt-slack.service. Copy to /etc/nvr-mqtt-slack.env,
# fill in the real values, then `sudo chmod 0600 /etc/nvr-mqtt-slack.env`.
# Do NOT commit the filled-in file — both values are secrets.
#
# NVR_MQTT_PASSWORD: broker password for user 'nvr'. Source of truth:
#   vault 00-config/production-values.md -> "Mosquitto MQTT Authentication".
# SLACK_WEBHOOK_URL: the same incoming-webhook Netdata + Uptime Kuma use.
#   Currently set in /etc/netdata/health_alarm_notify.conf (SLACK_WEBHOOK_URL).

NVR_MQTT_PASSWORD=changeme
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/XXXX/YYYY/ZZZZ
