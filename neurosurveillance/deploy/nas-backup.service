[Unit]
Description=NeuroSurveillance daily project backup to NAS
Documentation=file:///home/skimlab/sleep-recording-skim/vault/20-areas/data-storage/nas-backup.md
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
User=skimlab
Group=skimlab
Environment=HOME=/home/skimlab
ExecStart=/home/skimlab/sleep-recording-skim/neurosurveillance/deploy/nas-backup.sh
# Don't let a slow/hung NAS transfer run forever
TimeoutStartSec=1800
Nice=10
IOSchedulingClass=idle
