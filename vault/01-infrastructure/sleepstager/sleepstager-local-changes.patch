+class _RulesCard(QtWidgets.QWidget):
+    """LOCAL (Andrea): the scoring conventions at a glance, under the feature sliders.
+
+    Mirrors the vault's sleep-scoring-handbook §3 (decision flow) and §4 (draft conventions
+    C1–C12); edit both together. It takes the sidebar's leftover height and hides itself
+    when that is too short, so it never makes the window taller."""
+
+    # (condition, result) — result is a stage key, "keep" or free text; {cut} = the rule's wake cut
+    DECIDE = (("tone ≥ {cut} for > ½ epoch", "W"),
+              ("short burst (< ½ epoch)", "keep"),
+              ("slow δ + σ spindles", "NR"),
+              ("atonic · θ leads · δ low", "R"),
+              ("steady tone · δ low · no σ", "W*"),
+              ("still unsure", "⇧ flag"))
+    EDGES = ("NR starts at first δ, not EMG drop",
+             "R starts: θ > δ + σ down (rule late)",
+             "R ends at δ (→NR) or tone (→W)",
+             "in W: tone dips, EEG awake → W",
+             "lone arousal in NR, 1 side only → NR",
+             "moving: ignore δ, θ/δ; read σ, γ")
+    CHECK = ("NR with δ at W/R level → recheck",
+             "1-epoch R: ask the professor (C7)")
+
+    def __init__(self, cut=None):
+        super().__init__()
+        self.setSizePolicy(QtWidgets.QSizePolicy.Preferred, QtWidgets.QSizePolicy.Ignored)
+        self._lbl = QtWidgets.QLabel(self._html(cut), self)
+        self._lbl.setFont(_ui_font(FS_FEAT_BODY))
+        self._lbl.setTextFormat(QtCore.Qt.RichText); self._lbl.setWordWrap(True)
+        self._lbl.setStyleSheet(f"background:#f7f6f3;padding:6px {_DecisionLadder.PX - 2}px 8px")
+
+    def _html(self, cut):
+        def chip(r):
+            st = r.rstrip("*")
+            if st in _STAGE_COLOR:
+                return f"<b style='color:{_STAGE_COLOR[st]}'>{r}</b>"
+            return f"<span style='color:#666'>{r}</span>"
+        cut = f"{cut:.1f}" if cut else "cut"
+        from html import escape as e
+        sec = lambda t: f"<tr><td colspan='3' style='padding-top:5px;color:#888'>{t}</td></tr>"
+        rows = [sec("decide, in order")]
+        rows += [f"<tr><td style='color:#999'>{i}</td><td>{e(c.format(cut=cut))}</td>"
+                 f"<td align='right'>{chip(r)}</td></tr>" for i, (c, r) in enumerate(self.DECIDE, 1)]
+        rows += [sec("edges")] + [f"<tr><td style='color:#999'>·</td><td colspan='2'>{e(t)}</td></tr>" for t in self.EDGES]
+        rows += [sec("check")] + [f"<tr><td style='color:#c77700'>!</td><td colspan='2'>{e(t)}</td></tr>" for t in self.CHECK]
+        return (f"<div style='font-size:{FS_GLIDE_TITLE}pt;color:#111'><b>scoring rules</b>"
+                f"<span style='color:#999'>&nbsp;&nbsp;draft</span></div>"
+                f"<table width='100%' cellspacing='0' cellpadding='0' style='color:#222'>{''.join(rows)}</table>")
+
+    def resizeEvent(self, e):
+        super().resizeEvent(e)
+        need = self._lbl.heightForWidth(self.width())
+        self._lbl.setGeometry(0, 8, self.width(), need)
+        self._lbl.setVisible(self.height() >= need + 8)
+
+
