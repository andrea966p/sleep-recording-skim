# =============================================================================
# Sleep Recording SKIM: what never leaves this machine.
#
# Two rules behind every line here:
#   1. Anything a machine rewrites at runtime stays OUT of the repo. A
#      runtime-rewritten file inside a shared repo is what deadlocked
#      claude-portable for 19 days in 2026 (settings.json kept the tree dirty,
#      so `git rebase` refused to run and neither push nor pull could proceed).
#   2. Anything regenerable stays out, however large. neurosurveillance's Rust
#      target/ holds single .a files of 666 MB.
# =============================================================================

# --- Claude Code runtime state -----------------------------------------------
claude-config/settings.json
claude-config/**/*.local.json

# --- build artefacts ---------------------------------------------------------
node_modules/
dist/
dist-ssr/
build/
*.egg-info/
__pycache__/
*.py[cod]
src-tauri/target/
src-tauri/gen/schemas/

# --- environments and secrets ------------------------------------------------
venv/
.venv/
*-venv/
.env
.env.*
*.pem
*.key

# --- machine-local runtime output --------------------------------------------
*.log
exports/
sessions/
*.sqlite
*.sqlite-wal
*.sqlite-shm

# --- Syncthing leftovers (Syncthing is retired for this workspace) -----------
.stversions/
.stfolder/

# --- Obsidian per-machine window layout --------------------------------------
.obsidian/workspace*.json
.trash/

# --- misc --------------------------------------------------------------------
*.deb
.DS_Store
*.sw?

# --- symlinks bootstrap.sh creates inside the workspace ----------------------
# These point at claude-config/ with ABSOLUTE paths, so they are machine-specific
# and must never be committed: a path from one machine is wrong on every other.
/.claude/skills
/.agents/skills
/skills-lock.json

# Claude Code rewrites this as you approve permissions - same runtime-rewrite trap as
# settings.json, so the live file stays out and bootstrap.sh seeds it from
# claude-config/settings.local.template.json instead.
/.claude/settings.local.json

# Claude Code's agent worktrees. These are REAL git worktrees, registered in
# .git/worktrees and listed by `git worktree list`, so git already tracks their
# existence. Committing their working trees would copy the whole repo into
# itself, once per agent - 246 MB and 2228 files on 2026-09-23. Remove a stale
# one with `git worktree remove`, never with `rm -rf`.
/.claude/worktrees/

# Skill bundles the Claude Code client syncs down into the workspace. They are a
# CACHE: the directory names are server-side UUIDs that differ per machine, and
# the contents include vendored schema sets (the ISO-IEC29500 XSDs alone are
# most of 8.7 MB). Nothing here is authored in this repo.
claude-config/skills/synced/

# Local-only job monitor (rig-jobs.sh). Deliberately NOT in the repo: it is a
# scratch tool for watching strips and uploads on e10, not shared workflow.
# Ignored because `./skim push` commits everything untracked before it pushes,
# which swept it in once already.
/neurosurveillance/deploy/rig-jobs.sh
/neurosurveillance/deploy/rig_jobs.py
