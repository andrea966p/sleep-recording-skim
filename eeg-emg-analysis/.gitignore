# Python build/cache cruft
__pycache__/
*.py[cod]
*.egg-info/
build/
dist/

# Virtualenvs (the project venv lives at ~/eeg-analysis-venv, outside this tree)
.venv/
venv/

# Editor/OS
.DS_Store
*.swp

# Raw acquisition data is NEVER committed: it lives in ~/radix/data (775 GB)
*.xdat
*.xdat.json

# Stray runtime log written by the radiens client when allegoserver is unreachable
radiens.log

# Cards generated from an auto-generated cohort manifest (auto-<run_id>). They
# are reproducible from the feature cache in seconds and are named after a run
# id rather than a cohort, so they are working output, not a record. A curated
# cohort (cohorts/<NAME>.yaml) and its cards ARE versioned.
cards/out/auto-*/
